# =============================================================================
# HYPREP FOI Management System — Environment Variables (production)
# =============================================================================
# Copy to `.env.local` for local development, or set via `npx convex env set`
# on each Convex deployment (dev / staging / production).
#
#   npx convex env set VAR_NAME value
#
# Client-side vars are read by Vite (must start with VITE_); server-side vars
# are read inside Convex functions via the generated `env` export.
# =============================================================================

# -----------------------------------------------------------------------------
# Convex (client)
# -----------------------------------------------------------------------------
# Your Convex deployment URL (shown by `npx convex dev` / dashboard).
VITE_CONVEX_URL=http://127.0.0.1:3210
# Site URL (HTTP routes base). Use your custom domain or the *.convex.site URL.
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# -----------------------------------------------------------------------------
# Auth — Better Auth (server)
# -----------------------------------------------------------------------------
# Long random secret used to sign sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public base URL the auth client + SSO redirects use. Must be a valid URL
# with no trailing whitespace (e.g. https://foi.hyprep.gov.ng).
BETTER_AUTH_URL=
# Comma-separated browser origins allowed to call /api/auth/* (CORS), e.g.
#   FRONTEND_ORIGINS=https://foi.hyprep.gov.ng,http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# Microsoft Entra ID (OIDC) SSO — set to enable "Continue with Entra ID".
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=
ENTRA_ID_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0

# -----------------------------------------------------------------------------
# Email — Resend (server)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender (e.g. FOI Management System <foi@hyprep.gov.ng>)
EMAIL_FROM_ADDRESS=foi@hyprep.gov.ng
EMAIL_FROM_NAME=HYPREP FOI Management System

# -----------------------------------------------------------------------------
# SMS — Termii (server, optional)
# -----------------------------------------------------------------------------
TERMII_API_KEY=
# Approved sender ID (alphanumeric, e.g. HYPREP)
TERMII_SENDER_ID=HYPREP

# -----------------------------------------------------------------------------
# File pipeline (server)
# -----------------------------------------------------------------------------
# Virus scanning — ClamAV REST endpoint (optional; leave empty to skip scan).
CLAMAV_URL=

# OCR — Google Cloud Vision (optional; required for full-text search on scans).
# OCR_ENDPOINT is the full annotate URL, e.g.
# https://vision.googleapis.com/v1/images:annotate
# PDFs are automatically routed to files:annotate; images use images:annotate.
OCR_API_KEY=
OCR_ENDPOINT=

# Optional envelope-encryption key (AES-256) for restricted/confidential
# document payloads at rest. Generate with: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Webhooks (server)
# -----------------------------------------------------------------------------
# Shared secret for signing outbound webhooks and verifying inbound webhooks
# (HMAC-SHA256). Generate with: openssl rand -base64 32
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Monitoring (server, optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# CI / Deploy (only used in GitHub Actions — set as repo secrets)
# -----------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=             # Convex deploy key for CI pushes
