{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_CONVEX_URL=https://compassionate-caterpillar-373.eu-west-1.convex.cloud VITE_CONVEX_SITE_URL=https://compassionate-caterpillar-373.eu-west-1.convex.site npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://compassionate-caterpillar-373.eu-west-1.convex.site/api/auth/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
